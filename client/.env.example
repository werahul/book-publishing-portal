# Express API origin (server-only; used by the /api rewrite and server components)
API_URL=http://localhost:4000

# Must equal JWT_SECRET in server/.env — lets src/proxy.ts verify the session cookie.
# Server-only: never prefix with NEXT_PUBLIC_.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Show the demo-account shortcuts on the login page (set to "false" to hide)
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

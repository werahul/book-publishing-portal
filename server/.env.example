# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origin of the Next.js app (CORS allow-list; browser traffic normally arrives via the Next.js rewrite)
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (Render = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookleaf?retryWrites=true&w=majority
# Optional. Set only if `querySrv ECONNREFUSED` appears locally (Node's resolver can't do SRV lookups).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth ─────────────────────────────────────────────────
# At least 32 random chars. Must match JWT_SECRET in client/.env.local.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_MAX=10

# ── AI (Phase 3) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_CLASSIFY=llama-3.1-8b-instant
GROQ_MODEL_DRAFT=llama-3.3-70b-versatile

# ── Seed ─────────────────────────────────────────────────
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

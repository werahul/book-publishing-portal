# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origin of the Next.js app (CORS allow-list; browser traffic normally arrives via the Next.js rewrite)
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (Render = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookleaf?retryWrites=true&w=majority
# Optional. Set only if `querySrv ECONNREFUSED` appears locally (Node's resolver can't do SRV lookups).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth ─────────────────────────────────────────────────
# At least 32 random chars. Must match JWT_SECRET in client/.env.local.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_MAX=10

# ── AI ───────────────────────────────────────────────────
# Optional. Without a key the app still runs: keyword triage + manual replies.
GROQ_API_KEY=
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
GROQ_MODEL_DRAFT=openai/gpt-oss-120b

# ── Real-time ────────────────────────────────────────────
# Public origin of THIS API, where browsers open the Socket.IO connection
# (the Next.js rewrite can't proxy WebSockets). Must be reachable from the browser.
SOCKET_PUBLIC_URL=http://localhost:4000

# ── Seed ─────────────────────────────────────────────────
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

{
  "name": "bookleaf-support-portal",
  "private": true,
  "version": "0.1.0",
  "description": "BookLeaf Author Support & Communication Portal",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @bookleaf/shared",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server --",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "npm run build -w @bookleaf/shared"
  },
  "engines": {
    "node": ">=20.19"
  }
}
